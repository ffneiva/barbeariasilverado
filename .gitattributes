# Normaliza a quebra de linha no repositório.
* text=auto eol=lf

# Scripts precisam de LF mesmo em checkout no Windows: com CRLF, o shebang vira
# "#!/usr/bin/env bash\r" e o Linux não encontra o interpretador.
*.sh text eol=lf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.woff2 binary
*.ico binary

# Arquivos gerados — não poluem o diff de um PR nem contam como código escrito.
public/images/** linguist-generated=true
public/fonts/** linguist-generated=true
src/lib/image-manifest.json linguist-generated=true
package-lock.json linguist-generated=true
